{
	"$schema": "../../manifest-schema.json",
	"id": "Jojje.H2SignatureSuit",
	"name": "Hitman 2 Signature Suit",
	"description": "Use the Hitman 2 signature suit instead of Hitman 3.",
	"authors": ["Jojje"],
	"version": "1.3.1",
	"frameworkVersion": "3.0.0-rc.4",
	"url": "https://github.com/JojjeE/h3-hitman2-signature-suit",
	"conditions": { "supportedGames": ["h3"] },
	"options": [
		{
			"id": "sig",
			"type": "selection",
			"name": "Signature Suit",
			"defaultValue": "sig-sig",
			"options": [
				{
					"id": "sig-dni",
					"name": "Do not install",
					"description": "Do not replace the Signature Suit."
				},
				{
					"id": "sig-sig",
					"name": "Signature Suit",
					"description": "Replace the Signature Suit, with the H2 suit.",
					"data": {
						"contentFolders": ["base/nogloves/withoutgloves"]
					}
				},
				{
					"id": "sig-siggloves",
					"name": "Signature Suit with Gloves",
					"description": "Replace the Signature Suit, with the H2 suit, with gloves.",
					"data": {
						"contentFolders": ["base/nogloves/withgloves"]
					}
				}
			]
		},
		{
			"id": "siggloves",
			"type": "selection",
			"name": "Signature Suit with Gloves",
			"defaultValue": "siggloves-siggloves",
			"options": [
				{
					"id": "siggloves-dni",
					"name": "Do not install",
					"description": "Do not replace the Signature Suit with Gloves."
				},
				{
					"id": "siggloves-sig",
					"name": "Signature Suit",
					"description": "Replace the Signature Suit with Gloves, with the H2 suit.",
					"data": {
						"contentFolders": ["base/gloves/withoutgloves"]
					}
				},
				{
					"id": "siggloves-siggloves",
					"name": "Signature Suit with Gloves",
					"description": "Replace the Signature Suit with Gloves, with the H2 suit, with gloves.",
					"data": {
						"contentFolders": ["base/gloves/withgloves"]
					}
				}
			]
		},
		{
			"id": "variants-sig",
			"type": "optionGroup",
			"name": "Signature Suit",
			"options": [
				{
					"id": "sig-variant",
					"type": "selection",
					"name": "Variant",
					"defaultValue": "sig-variant-default",
					"options": [
						{
							"id": "sig-variant-default",
							"name": "Default",
							"description": "No change."
						},
						{
							"id": "sig-variant-buttoned",
							"name": "Buttoned",
							"description": "Buttoned jacket.",
							"image": "buttoned.jpg",
							"data": {
								"contentFolders": [
									"variant/nogloves/buttoned",
									"variant_assets/buttoned"
								]
							}
						},
						{
							"id": "sig-variant-suburban",
							"name": "Buttoned (Suburban)",
							"description": "Suburban Suit-styled buttoned jacket. Wider lapels, pockets are lower down and exposes less of the shirt, tie and belt.",
							"image": "buttoned_suburban.jpg",
							"data": {
								"contentFolders": [
									"variant/nogloves/buttoned_suburban",
									"variant_assets/buttoned",
									"variant_assets/buttoned_suburban"
								]
							}
						},
						{
							"id": "sig-variant-tieclip",
							"name": "Tie clip",
							"description": "With tie clip.",
							"image": "tieclip.jpg",
							"data": {
								"contentFolders": [
									"variant/nogloves/tieclip"
								]
							}
						}
					]
				}
			],
			"displayCondition": "mod_option(\"Jojje.H2SignatureSuit@1.3.1\", \"sig\") != Some(\"sig-dni\")"
		},
		{
			"id": "variants-siggloves",
			"type": "optionGroup",
			"name": "Signature Suit with Gloves",
			"options": [
				{
					"id": "siggloves-variant",
					"type": "selection",
					"name": "Variant",
					"defaultValue": "siggloves-variant-default",
					"options": [
						{
							"id": "siggloves-variant-default",
							"name": "Default",
							"description": "No change."
						},
						{
							"id": "siggloves-variant-buttoned",
							"name": "Buttoned",
							"description": "Buttoned jacket.",
							"image": "buttoned.jpg",
							"data": {
								"contentFolders": [
									"variant/gloves/buttoned",
									"variant_assets/buttoned"
								]
							}
						},
						{
							"id": "siggloves-variant-suburban",
							"name": "Buttoned (Suburban)",
							"description": "Suburban Suit-styled buttoned jacket. Wider lapels, pockets are lower down and exposes less of the shirt, tie and belt.",
							"image": "buttoned_suburban.jpg",
							"data": {
								"contentFolders": [
									"variant/gloves/buttoned_suburban",
									"variant_assets/buttoned",
									"variant_assets/buttoned_suburban"
								]
							}
						},
						{
							"id": "siggloves-variant-tieclip",
							"name": "Tie clip",
							"description": "With tie clip.",
							"image": "tieclip.jpg",
							"data": {
								"contentFolders": [
									"variant/gloves/tieclip"
								]
							}
						}
					]
				}
			],
			"displayCondition": "mod_option(\"Jojje.H2SignatureSuit@1.3.1\", \"siggloves\") != Some(\"siggloves-dni\")"
		}
	]
}
